<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TokoKu - Online Store</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    body { font-family: 'Inter', system-ui, sans-serif; }
    .product-card { transition: all 0.3s ease; }
    .product-card:hover { transform: translateY(-6px); box-shadow: 0 12px 24px -8px rgba(0,0,0,0.15); }
    .cart-sidebar { transition: transform 0.3s ease; }
    .btn-primary { background: linear-gradient(135deg, #4f46e5, #7c3aed); }
    .btn-primary:hover { background: linear-gradient(135deg, #4338ca, #6d28d9); }
    .hidden-admin { display: none !important; }
  </style>
</head>
<body class="bg-gray-50 text-gray-800">

  <!-- Navbar -->
  <nav class="bg-white/90 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 bg-gradient-to-br from-indigo-600 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-lg shadow-md">T</div>
        <span class="font-bold text-xl tracking-tight">TokoKu</span>
      </div>
      <div class="hidden md:flex items-center gap-8 text-sm font-medium">
        <a href="#produk" class="hover:text-indigo-600 transition">Produk</a>
        <a href="#cara-order" class="hover:text-indigo-600 transition">Cara Order</a>
        <a href="#admin" class="hover:text-indigo-600 transition">Admin</a>
      </div>
      <div class="flex items-center gap-4">
        <button onclick="toggleCart()" class="relative p-2 hover:bg-gray-100 rounded-full transition">
          <i class="fas fa-shopping-cart text-lg"></i>
          <span id="cart-count" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center font-medium">0</span>
        </button>
        <a href="#admin" class="btn-primary text-white px-4 py-2 rounded-lg text-sm font-medium shadow-md hover:shadow-lg transition">
          <i class="fas fa-user-shield mr-1"></i> Admin
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHZpZXdCb3g9IjAgMCA2MCA2MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxnIGZpbGw9IiNmZmZmZmYiIGZpbGwtb3BhY2l0eT0iMC4wNSI+PHBhdGggZD0iTTM2IDM0djItSDI0di0yaDEyek0zNiAyNHYySDI0di0yaDEyeiIvPjwvZz48L2c+PC9zdmc+')] opacity-30"></div>
    <div class="max-w-6xl mx-auto px-4 py-20 md:py-28 text-center relative">
      <h1 class="text-4xl md:text-6xl font-bold mb-5 tracking-tight">Toko Online Terpercaya</h1>
      <p class="text-lg md:text-xl opacity-90 mb-10 max-w-2xl mx-auto">Produk berkualitas • Pembayaran QRIS • Aman & mudah</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#produk" class="bg-white text-indigo-700 font-semibold px-8 py-3.5 rounded-full hover:bg-gray-100 transition shadow-lg">
          Lihat Produk
        </a>
        <a href="#cara-order" class="bg-white/20 backdrop-blur text-white font-semibold px-8 py-3.5 rounded-full hover:bg-white/30 transition border border-white/30">
          Cara Order
        </a>
      </div>
    </div>
  </section>

  <!-- Produk -->
  <section id="produk" class="max-w-6xl mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-3">Katalog Produk</h2>
      <p class="text-gray-500">Pilih produk terbaik untuk kebutuhanmu</p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="product-list">
      <!-- Produk di-render oleh JavaScript -->
    </div>

    <!-- Empty state -->
    <div id="empty-products" class="text-center py-16 hidden">
      <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-5">
        <i class="fas fa-box-open text-3xl text-gray-400"></i>
      </div>
      <h3 class="text-xl font-semibold text-gray-700 mb-2">Belum ada produk</h3>
      <p class="text-gray-500 mb-6">Admin belum menambahkan produk. Silakan cek lagi nanti.</p>
      <a href="#admin" class="inline-flex items-center gap-2 text-indigo-600 font-medium hover:underline">
        <i class="fas fa-user-shield"></i> Masuk sebagai Admin
      </a>
    </div>
  </section>

  <!-- Cara Order -->
  <section id="cara-order" class="bg-white py-16 border-y">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">Cara Order</h2>
        <p class="text-gray-500">Mudah dan cepat hanya dalam 3 langkah</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center p-6 rounded-2xl bg-gray-50">
          <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-5">1</div>
          <h3 class="font-semibold text-lg mb-2">Pilih Produk</h3>
          <p class="text-gray-500 text-sm">Tambahkan produk yang diinginkan ke keranjang belanja</p>
        </div>
        <div class="text-center p-6 rounded-2xl bg-gray-50">
          <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-5">2</div>
          <h3 class="font-semibold text-lg mb-2">Checkout & Bayar</h3>
          <p class="text-gray-500 text-sm">Scan QRIS yang muncul setelah checkout</p>
        </div>
        <div class="text-center p-6 rounded-2xl bg-gray-50">
          <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-5">3</div>
          <h3 class="font-semibold text-lg mb-2">Konfirmasi</h3>
          <p class="text-gray-500 text-sm">Kirim bukti transfer via WhatsApp setelah bayar</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Admin Panel -->
  <section id="admin" class="max-w-4xl mx-auto px-4 py-16">
    
    <!-- Login Admin -->
    <div id="admin-login" class="bg-white rounded-2xl shadow-lg border overflow-hidden">
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-8 py-5">
        <h2 class="text-xl font-bold flex items-center gap-2">
          <i class="fas fa-lock"></i> Login Admin
        </h2>
        <p class="text-sm opacity-90 mt-1">Masukkan kode akses untuk mengelola toko</p>
      </div>
      <div class="p-8">
        <div class="max-w-sm mx-auto">
          <label class="block text-sm font-medium text-gray-700 mb-2">Kode Akses Admin</label>
          <input type="password" id="admin-code" placeholder="Masukkan kode..." 
                 class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-4"
                 onkeypress="if(event.key==='Enter') loginAdmin()">
          <button onclick="loginAdmin()" class="btn-primary text-white px-5 py-3 rounded-lg w-full text-sm font-medium">
            <i class="fas fa-sign-in-alt mr-2"></i> Masuk
          </button>
          <p id="login-error" class="text-red-500 text-sm mt-3 text-center hidden">Kode salah! Coba lagi.</p>
        </div>
      </div>
    </div>

    <!-- Admin Content -->
    <div id="admin-content" class="hidden">
      <div class="bg-white rounded-2xl shadow-lg border overflow-hidden">
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-8 py-5 flex justify-between items-center">
          <div>
            <h2 class="text-xl font-bold flex items-center gap-2">
              <i class="fas fa-user-shield"></i> Panel Admin
            </h2>
            <p class="text-sm opacity-90 mt-1">Kelola produk dan pembayaran</p>
          </div>
          <button onclick="logoutAdmin()" class="bg-white/20 hover:bg-white/30 text-white text-sm px-4 py-2 rounded-lg transition">
            <i class="fas fa-sign-out-alt mr-1"></i> Keluar
          </button>
        </div>
        
        <div class="p-8 space-y-8">
          
          <!-- Kelola Produk -->
          <div>
            <h3 class="font-semibold text-lg mb-4 flex items-center gap-2">
              <i class="fas fa-box text-indigo-600"></i> Kelola Produk
            </h3>
            
            <div class="bg-gray-50 p-6 rounded-xl border mb-6">
              <h4 class="font-medium mb-4">Tambah Produk Baru</h4>
              <div class="grid md:grid-cols-2 gap-4">
                <input type="text" id="new-product-name" placeholder="Nama produk" class="border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <input type="number" id="new-product-price" placeholder="Harga (contoh: 50000)" class="border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <input type="text" id="new-product-desc" placeholder="Deskripsi singkat" class="border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 md:col-span-2">
                <input type="text" id="new-product-image" placeholder="URL gambar (opsional)" class="border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 md:col-span-2">
              </div>
              <button onclick="addNewProduct()" class="btn-primary text-white px-5 py-2.5 rounded-lg text-sm font-medium mt-4">
                <i class="fas fa-plus mr-1"></i> Tambah Produk
              </button>
            </div>

            <div id="admin-product-list" class="space-y-3"></div>
          </div>

          <!-- Pengaturan QRIS -->
          <div>
            <h3 class="font-semibold text-lg mb-4 flex items-center gap-2">
              <i class="fas fa-qrcode text-indigo-600"></i> Pengaturan Pembayaran QRIS
            </h3>
            <div class="bg-gray-50 p-6 rounded-xl border">
              <p class="text-sm text-gray-600 mb-4">Masukkan link gambar QRIS kamu. Gambar ini akan muncul saat pembeli melakukan checkout.</p>
              
              <label class="block text-sm font-medium text-gray-700 mb-2">URL Gambar QRIS</label>
              <input type="text" id="qris-url" placeholder="https://i.ibb.co/xxxxx/qris.jpg" 
                     class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-3">
              
              <label class="block text-sm font-medium text-gray-700 mb-2">Nomor / Nama Rekening (opsional)</label>
              <input type="text" id="qris-info" placeholder="Contoh: BCA 1234567890 a.n. Nama Kamu" 
                     class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 mb-4">
              
              <button onclick="saveQris()" class="btn-primary text-white px-5 py-2.5 rounded-lg text-sm font-medium">
                <i class="fas fa-save mr-1"></i> Simpan Pengaturan QRIS
              </button>
              
              <div id="qris-preview" class="mt-6 hidden">
                <p class="text-sm font-medium mb-2">Preview QRIS:</p>
                <img id="qris-preview-img" src="" alt="QRIS" class="max-w-xs mx-auto border rounded-xl shadow">
                <p id="qris-preview-info" class="text-center text-sm text-gray-600 mt-2"></p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Cart Sidebar -->
  <div id="cart-sidebar" class="cart-sidebar fixed top-0 right-0 h-full w-full max-w-md bg-white shadow-2xl transform translate-x-full z-50 flex flex-col">
    <div class="p-5 border-b flex justify-between items-center bg-gray-50">
      <h3 class="font-bold text-lg">Keranjang Belanja</h3>
      <button onclick="toggleCart()" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-200 transition">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div id="cart-items" class="flex-1 p-5 overflow-y-auto"></div>
    <div class="p-5 border-t bg-white">
      <div class="flex justify-between items-center mb-4">
        <span class="font-medium text-gray-600">Total</span>
        <span id="cart-total" class="text-xl font-bold text-indigo-600">Rp 0</span>
      </div>
      <button onclick="checkout()" class="w-full btn-primary text-white py-3.5 rounded-xl font-semibold shadow-md hover:shadow-lg transition">
        Checkout & Bayar QRIS
      </button>
    </div>
  </div>
  <div id="cart-overlay" onclick="toggleCart()" class="fixed inset-0 bg-black/50 hidden z-40 backdrop-blur-sm"></div>

  <!-- Modal QRIS Payment -->
  <div id="qris-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 relative">
      <button onclick="closeQrisModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
        <i class="fas fa-times text-xl"></i>
      </button>
      
      <h3 class="text-xl font-bold text-center mb-2">Pembayaran QRIS</h3>
      <p class="text-center text-gray-500 text-sm mb-6">Scan QRIS di bawah untuk membayar</p>
      
      <div class="text-center mb-4">
        <p class="text-2xl font-bold text-indigo-600" id="modal-total">Rp 0</p>
      </div>
      
      <div id="modal-qris-container" class="text-center">
        <img id="modal-qris-img" src="" alt="QRIS" class="max-w-[240px] mx-auto border rounded-xl shadow mb-3">
        <p id="modal-qris-info" class="text-sm text-gray-600"></p>
      </div>
      
      <div id="modal-no-qris" class="text-center py-8 hidden">
        <i class="fas fa-exclamation-circle text-4xl text-yellow-500 mb-3"></i>
        <p class="text-gray-600">Admin belum mengatur QRIS.<br>Silakan hubungi admin.</p>
      </div>
      
      <div class="mt-6 space-y-3">
        <a href="https://wa.me/6283838588520?text=Halo%20Admin%2C%20saya%20sudah%20bayar.%20Berikut%20bukti%20transfernya%3A" 
           target="_blank"
           class="flex items-center justify-center gap-3 w-full bg-green-500 hover:bg-green-600 text-white py-3.5 rounded-xl font-semibold transition shadow-md">
          <i class="fab fa-whatsapp text-2xl"></i>
          <span>Kirim Bukti Transfer via WhatsApp</span>
        </a>
        <p class="text-center text-xs text-gray-500">Klik tombol di atas setelah melakukan pembayaran</p>
      </div>
      
      <button onclick="closeQrisModal()" class="w-full mt-4 border border-gray-200 py-3 rounded-xl font-medium hover:bg-gray-50 transition">
        Tutup
      </button>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-12">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-gradient-to-br from-indigo-600 to-purple-600 rounded-lg flex items-center justify-center text-white font-bold text-sm">T</div>
          <span class="font-bold text-white">TokoKu</span>
        </div>
        <p class="text-sm text-center">© 2026 TokoKu. Website demo untuk keperluan legal.</p>
      </div>
    </div>
  </footer>

  <script>
    let products = JSON.parse(localStorage.getItem('tokoku_products')) || [];
    let cart = JSON.parse(localStorage.getItem('tokoku_cart')) || [];
    let qrisUrl = localStorage.getItem('tokoku_qris_url') || '';
    let qrisInfo = localStorage.getItem('tokoku_qris_info') || '';
    const ADMIN_CODE = 'ALAMGANTENG1';

    function loginAdmin() {
      const code = document.getElementById('admin-code').value.trim();
      const errorEl = document.getElementById('login-error');
      if (code === ADMIN_CODE) {
        document.getElementById('admin-login').classList.add('hidden');
        document.getElementById('admin-content').classList.remove('hidden');
        errorEl.classList.add('hidden');
        document.getElementById('admin-code').value = '';
        document.getElementById('qris-url').value = qrisUrl;
        document.getElementById('qris-info').value = qrisInfo;
        updateQrisPreview();
        renderAdminProducts();
        sessionStorage.setItem('tokoku_admin', 'true');
      } else {
        errorEl.classList.remove('hidden');
      }
    }

    function logoutAdmin() {
      document.getElementById('admin-login').classList.remove('hidden');
      document.getElementById('admin-content').classList.add('hidden');
      sessionStorage.removeItem('tokoku_admin');
    }

    if (sessionStorage.getItem('tokoku_admin') === 'true') {
      document.getElementById('admin-login').classList.add('hidden');
      document.getElementById('admin-content').classList.remove('hidden');
      document.getElementById('qris-url').value = qrisUrl;
      document.getElementById('qris-info').value = qrisInfo;
      updateQrisPreview();
    }

    function renderProducts() {
      const container = document.getElementById('product-list');
      const emptyEl = document.getElementById('empty-products');
      if (products.length === 0) {
        container.innerHTML = '';
        emptyEl.classList.remove('hidden');
        return;
      }
      emptyEl.classList.add('hidden');
      container.innerHTML = products.map(p => `
        <div class="product-card bg-white rounded-2xl shadow-sm overflow-hidden border border-gray-100">
          <div class="relative">
            <img src="\( {p.image}" alt=" \){p.name}" class="w-full h-48 object-cover" onerror="this.src='https://placehold.co/400x280/4f46e5/ffffff?text=Produk'">
            <span class="absolute top-3 left-3 bg-indigo-600 text-white text-xs font-medium px-2.5 py-1 rounded-full">Ready</span>
          </div>
          <div class="p-5">
            <h3 class="font-semibold text-lg mb-1 line-clamp-1">${p.name}</h3>
            <p class="text-gray-500 text-sm mb-4 line-clamp-2">${p.desc}</p>
            <div class="flex justify-between items-center">
              <span class="font-bold text-lg text-indigo-600">Rp ${p.price.toLocaleString('id-ID')}</span>
              <button onclick="addToCart(${p.id})" class="btn-primary text-white px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-1.5">
                <i class="fas fa-plus text-xs"></i> Keranjang
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function renderAdminProducts() {
      const container = document.getElementById('admin-product-list');
      if (products.length === 0) {
        container.innerHTML = `<p class="text-gray-500 text-sm text-center py-6">Belum ada produk. Tambahkan produk di atas.</p>`;
        return;
      }
      container.innerHTML = products.map(p => `
        <div class="flex items-center gap-4 bg-white border rounded-xl p-4">
          <img src="${p.image}" class="w-14 h-14 rounded-lg object-cover" onerror="this.src='https://placehold.co/100x100/4f46e5/ffffff?text=P'">
          <div class="flex-1 min-w-0">
            <h4 class="font-medium truncate">${p.name}</h4>
            <p class="text-sm text-indigo-600 font-semibold">Rp ${p.price.toLocaleString('id-ID')}</p>
          </div>
          <button onclick="deleteProduct(${p.id})" class="text-red-500 hover:bg-red-50 p-2 rounded-lg transition" title="Hapus">
            <i class="fas fa-trash"></i>
          </button>
        </div>
      `).join('');
    }

    function addNewProduct() {
      const name = document.getElementById('new-product-name').value.trim();
      const price = parseInt(document.getElementById('new-product-price').value);
      const desc = document.getElementById('new-product-desc').value.trim() || "Produk";
      const image = document.getElementById('new-product-image').value.trim() || 
                    `https://placehold.co/400x280/4f46e5/ffffff?text=${encodeURIComponent(name.substring(0,12) || 'Produk')}`;
      if (!name || !price || price <= 0) {
        alert('Mohon isi nama dan harga produk dengan benar!');
        return;
      }
      const newId = products.length > 0 ? Math.max(...products.map(p => p.id)) + 1 : 1;
      products.push({ id: newId, name, price, desc, image });
      localStorage.setItem('tokoku_products', JSON.stringify(products));
      document.getElementById('new-product-name').value = '';
      document.getElementById('new-product-price').value = '';
      document.getElementById('new-product-desc').value = '';
      document.getElementById('new-product-image').value = '';
      renderProducts();
      renderAdminProducts();
      alert('Produk berhasil ditambahkan!');
    }

    function deleteProduct(id) {
      if (!confirm('Yakin ingin menghapus produk ini?')) return;
      products = products.filter(p => p.id !== id);
      localStorage.setItem('tokoku_products', JSON.stringify(products));
      cart = cart.filter(item => item.id !== id);
      localStorage.setItem('tokoku_cart', JSON.stringify(cart));
      renderProducts();
      renderAdminProducts();
      updateCartUI();
    }

    function saveQris() {
      qrisUrl = document.getElementById('qris-url').value.trim();
      qrisInfo = document.getElementById('qris-info').value.trim();
      localStorage.setItem('tokoku_qris_url', qrisUrl);
      localStorage.setItem('tokoku_qris_info', qrisInfo);
      updateQrisPreview();
      alert('Pengaturan QRIS berhasil disimpan!');
    }

    function updateQrisPreview() {
      const preview = document.getElementById('qris-preview');
      const img = document.getElementById('qris-preview-img');
      const info = document.getElementById('qris-preview-info');
      if (qrisUrl) {
        preview.classList.remove('hidden');
        img.src = qrisUrl;
        info.textContent = qrisInfo || '';
      } else {
        preview.classList.add('hidden');
      }
    }

    function addToCart(id) {
      const product = products.find(p => p.id === id);
      if (!product) return;
      const existing = cart.find(item => item.id === id);
      if (existing) existing.qty += 1;
      else cart.push({ ...product, qty: 1 });
      localStorage.setItem('tokoku_cart', JSON.stringify(cart));
      updateCartUI();
    }

    function removeFromCart(id) {
      cart = cart.filter(item => item.id !== id);
      localStorage.setItem('tokoku_cart', JSON.stringify(cart));
      updateCartUI();
    }

    function changeQty(id, delta) {
      const item = cart.find(i => i.id === id);
      if (!item) return;
      item.qty += delta;
      if (item.qty <= 0) removeFromCart(id);
      else {
        localStorage.setItem('tokoku_cart', JSON.stringify(cart));
        updateCartUI();
      }
    }

    function updateCartUI() {
      const count = cart.reduce((sum, item) => sum + item.qty, 0);
      document.getElementById('cart-count').textContent = count;
      const container = document.getElementById('cart-items');
      if (cart.length === 0) {
        container.innerHTML = `
          <div class="flex flex-col items-center justify-center h-full text-gray-400 py-16">
            <i class="fas fa-shopping-bag text-5xl mb-4 opacity-30"></i>
            <p>Keranjang masih kosong</p>
          </div>`;
      } else {
        container.innerHTML = cart.map(item => `
          <div class="flex gap-4 mb-5 pb-5 border-b border-gray-100 last:border-0">
            <img src="${item.image}" class="w-20 h-20 rounded-xl object-cover flex-shrink-0" onerror="this.src='https://placehold.co/80x80/4f46e5/ffffff?text=P'">
            <div class="flex-1 min-w-0">
              <h4 class="font-medium text-sm truncate">${item.name}</h4>
              <p class="text-indigo-600 font-semibold text-sm mt-0.5">Rp ${item.price.toLocaleString('id-ID')}</p>
              <div class="flex items-center gap-3 mt-2">
                <button onclick="changeQty(${item.id}, -1)" class="w-7 h-7 rounded-full border flex items-center justify-center text-sm hover:bg-gray-100">−</button>
                <span class="text-sm font-medium w-6 text-center">${item.qty}</span>
                <button onclick="changeQty(${item.id}, 1)" class="w-7 h-7 rounded-full border flex items-center justify-center text-sm hover:bg-gray-100">+</button>
              </div>
            </div>
            <button onclick="removeFromCart(${item.id})" class="text-gray-400 hover:text-red-500 self-start">
              <i class="fas fa-trash-alt"></i>
            </button>
          </div>
        `).join('');
      }
      const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
      document.getElementById('cart-total').textContent = 'Rp ' + total.toLocaleString('id-ID');
    }

    function toggleCart() {
      const sidebar = document.getElementById('cart-sidebar');
      const overlay = document.getElementById('cart-overlay');
      sidebar.classList.toggle('translate-x-full');
      overlay.classList.toggle('hidden');
      document.body.classList.toggle('overflow-hidden');
    }

    function checkout() {
      if (cart.length === 0) {
        alert('Keranjang masih kosong!');
        return;
      }
      const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
      document.getElementById('modal-total').textContent = 'Rp ' + total.toLocaleString('id-ID');
      const img = document.getElementById('modal-qris-img');
      const info = document.getElementById('modal-qris-info');
      const container = document.getElementById('modal-qris-container');
      const noQris = document.getElementById('modal-no-qris');
      if (qrisUrl) {
        container.classList.remove('hidden');
        noQris.classList.add('hidden');
        img.src = qrisUrl;
        info.textContent = qrisInfo || '';
      } else {
        container.classList.add('hidden');
        noQris.classList.remove('hidden');
      }
      document.getElementById('qris-modal').classList.remove('hidden');
      toggleCart();
    }

    function closeQrisModal() {
      document.getElementById('qris-modal').classList.add('hidden');
    }

    renderProducts();
    updateCartUI();
    if (sessionStorage.getItem('tokoku_admin') === 'true') {
      renderAdminProducts();
    }
  </script>
</body>
</html>
